# Copy to .env (git-ignored) and fill in from your identity provider's app registration.
# Placeholders only: no real hostnames, tenant ids or secrets belong in this repo.
CAMBIUM_OIDC_ISSUER=https://idp.example.internal/<tenant-or-realm>/v2.0
CAMBIUM_OIDC_AUDIENCE=<api-client-id-or-audience>
CAMBIUM_OIDC_JWKS_URL=https://idp.example.internal/<tenant-or-realm>/discovery/v2.0/keys
CAMBIUM_OIDC_USER_CLAIM=preferred_username
CAMBIUM_OIDC_GROUPS_CLAIM=groups
CAMBIUM_RATE=50
CAMBIUM_BURST=200
