{
  "_about": "Cambium review-UI tokens (concept). Roles from the design phase; values set by the brand phase.",
  "color": {
    "bg": "#ffffff",
    "surface": "#f3f6f4",
    "border": "#d9e1dc",
    "border-input": "#6f7f76",
    "text": "#16201b",
    "text-muted": "#4f5d55",
    "accent": "#1d5c45",
    "on-accent": "#ffffff",
    "danger": "#b42318",
    "success": "#1d6b3a",
    "diff-add-bg": "#e6f4ea",
    "diff-del-bg": "#fbe9e7"
  },
  "pairs": [
    ["text", "bg"], ["text", "surface"], ["text-muted", "bg"], ["text-muted", "surface"],
    ["on-accent", "accent"], ["accent", "bg"], ["danger", "bg"], ["success", "bg"],
    ["text", "diff-add-bg"], ["text", "diff-del-bg"], ["border-input", "bg", "ui"]
  ],
  "font": { "sans": "IBM Plex Sans, system-ui, sans-serif", "mono": "IBM Plex Mono, ui-monospace, monospace" },
  "type": { "xs": {"size": 12, "line": 16, "weight": 500}, "sm": {"size": 14, "line": 20, "weight": 400},
            "base": {"size": 16, "line": 24, "weight": 400}, "lg": {"size": 20, "line": 28, "weight": 600} },
  "space": [0, 4, 8, 12, 16, 24, 32, 48],
  "radius": {"sm": 4, "md": 8},
  "terminal": { "added": "green", "removed": "red", "id": "yellow", "note": "CLI uses ANSI roles only; no colour required to read output" }
}
